draw_set_valign(fa_middle)

draw_text_transformed(room_width / 2, room_height * 0.2, "Croquet", 1.5, 1.5, 0)
draw_text_transformed(room_width / 2, room_height * 0.35, "Bump", 1.5, 1.5, 0)

draw_set_font(-1)
draw_set_colour(-1)
draw_set_halign(-1)
draw_set_valign(-1)