// Delay for start
timer_delay_start = 1.5 * FPS_GAME

// Variavel de controle para poder atirar
can_shoot = true

// Angulo atual da mira do player
ang_to_shoot_start = 0
ang_to_shoot = ang_to_shoot_start

// Variavel de controle para rodar a funcao de carga da mira
draw_sight = false

// Lista com todos "frames" da animacao de ataque
array_sprites_shoot = [spr_player_attack_1, spr_player_attack_2, spr_player_attack_3, spr_player_attack_4]
array_sprites_shoot_ind = 0